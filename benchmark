#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$ROOT/.venv/bin/python"
[[ -x "$PY" ]] || PY="$(command -v python3 || true)"
BENCHES=(core coding-agent rag vision image speech music web)

if [[ "$(uname -s)" == "Darwin" ]]; then
  RESULTS_ROOT="${BENCH_RESULTS_DIR:-$HOME/Library/Application Support/ai-benchmark}"
else
  RESULTS_ROOT="${BENCH_RESULTS_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ai-benchmark}"
fi

python_environment_fingerprint() {
  "$PY" - "$ROOT/.venv" "$ROOT/.venv-lcb" <<'PY'
import hashlib, json, subprocess, sys
from pathlib import Path

def fingerprint(venv: Path):
    python = venv / "bin" / "python"
    if not python.exists():
        return None
    version = subprocess.check_output([str(python), "--version"], text=True).strip()
    packages = subprocess.check_output([str(python), "-m", "pip", "freeze", "--all"], text=True).splitlines()
    payload = {"python_version": version, "packages": sorted(packages)}
    encoded = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode("utf-8")
    return {"sha256": hashlib.sha256(encoded).hexdigest(), **payload}

print(json.dumps({"project": fingerprint(Path(sys.argv[1])), "livecodebench": fingerprint(Path(sys.argv[2]))}, separators=(",", ":")))
PY
}

usage() {
  cat <<'TXT'
Benchmark

Usage:
  ./benchmark                            interactive checklist
  ./benchmark start all [options]
  ./benchmark start core rag vision [options]
  ./benchmark scan
  ./benchmark status [run-id]
  ./benchmark stop [run-id] [--force]
  ./benchmark resume [run-id]
  ./benchmark cleanup [run-id]
  ./benchmark list-runs
  ./benchmark environment

Start options:
  --profile quick|standard|full
  --machine NAME       label results with the measured machine name
  --without-livecodebench  skip the isolated external LiveCodeBench suite
  --cleanup-on-success     remove benchmark cache and non-retained Ollama models after success
  --keep-model MODEL       retain this Ollama model during cleanup (repeatable)

Environment:
  BENCH_RESULTS_DIR    override the persistent results directory
TXT
}

show_environment() {
  configure_cache_dir
  "$PY" - "$RESULTS_ROOT" "$BENCH_CACHE_DIR" <<'PY'
import platform, shutil, subprocess, sys

def version(command):
    if shutil.which(command[0]) is None:
        return "not installed"
    completed = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    return completed.stdout.strip() if completed.returncode == 0 else "unavailable"

print("Benchmark environment")
print(f"Platform: {platform.platform()}")
print(f"Python:   {sys.version.splitlines()[0]}")
print(f"Ollama:   {version(['ollama', '--version'])}")
print(f"Docker:   {version(['docker', 'version', '--format', '{{.Server.Version}}'])}")
print(f"Results:  {sys.argv[1]}")
print(f"Cache:    {sys.argv[2]}")
print("Models:")
models = version(['ollama', 'list'])
print(models if models != "not installed" else "  Ollama is not installed")
PY
}

latest_run() {
  "$PY" - "$RESULTS_ROOT/runs" <<'PY'
import sys
from pathlib import Path
root=Path(sys.argv[1])
runs=[p for p in root.glob('*/*') if p.is_dir() and (p/'state.json').exists()] if root.exists() else []
print(max(runs, key=lambda p: p.stat().st_mtime) if runs else '')
PY
}

resolve_run() {
  local id="${1:-}"
  if [[ -z "$id" ]]; then latest_run; return; fi
  local found
  found="$("$PY" - "$RESULTS_ROOT/runs" "$id" <<'PY'
import sys
from pathlib import Path
root=Path(sys.argv[1]); rid=sys.argv[2]
for p in root.glob('*/*') if root.exists() else []:
    if p.is_dir() and p.name == rid:
        print(p); break
PY
)"
  [[ -n "$found" ]] || { echo "ERROR: run not found: $id" >&2; exit 1; }
  echo "$found"
}

find_machine_config() {
  local path="$ROOT/config/models.toml"
  [[ -f "$path" ]] || {
    echo "ERROR: global model catalog is missing: $path" >&2
    exit 1
  }
  echo "$path"
}

configure_cache_dir() {
  [[ -n "${BENCH_CACHE_DIR:-}" ]] && { export BENCH_CACHE_DIR; return; }
  local ollama_models_dir="${OLLAMA_MODELS:-}"
  if [[ -z "$ollama_models_dir" ]] && command -v systemctl >/dev/null 2>&1; then
    ollama_models_dir="$(systemctl show ollama --property=Environment --value 2>/dev/null | sed -n 's/.*OLLAMA_MODELS=\([^ ]*\).*/\1/p' | head -n1)"
  fi
  ollama_models_dir="${ollama_models_dir:-$HOME/.ollama/models}"
  export BENCH_CACHE_DIR="$ollama_models_dir/benchmark-cache"
}

interactive() {
  command -v dialog >/dev/null 2>&1 || {
    echo "dialog is missing. Run ./bootstrap.sh first, or use CLI mode." >&2
    exit 1
  }
  local choices profile machine selection
  selection=$(dialog --stdout --menu "Select benchmarks" 13 72 2 \
    all "ALL - all benchmarks" \
    custom "Choose individual benchmarks") || exit 0
  if [[ "$selection" == "all" ]]; then
    choices=$(printf '%s\n' "${BENCHES[@]}")
  else
    choices=$(dialog --stdout --separate-output --checklist "Select benchmarks (space = toggle)" 20 72 9 \
    core "Core LLM" on \
    coding-agent "Coding & Agent" off \
    rag "RAG / Documents" off \
    vision "Vision / Screenshots" off \
    image "Image Generation" off \
    speech "Speech & Audio" off \
    music "Music Generation" off \
    web "Web / Research (local SearXNG)" off) || exit 0
  fi
  [[ -n "$choices" ]] || { echo "No benchmarks selected."; exit 0; }
  profile=$(dialog --stdout --radiolist "Profile" 12 55 4 quick "Quick validation" off standard "Primary comparison" on full "Complete external sets" off) || exit 0
  machine="$(hostname -s 2>/dev/null || hostname)"
  local with_lcb=0
  if grep -qx coding-agent <<<"$choices"; then
    with_lcb=1
  fi
  local arr=() line
  while IFS= read -r line; do
    [[ -n "$line" ]] && arr+=("$line")
  done <<< "$choices"
  if ((with_lcb)); then
    "$0" start "${arr[@]}" --profile "$profile" --machine "$machine" --with-livecodebench
  else
    "$0" start "${arr[@]}" --profile "$profile" --machine "$machine"
  fi
}

start_run() {
  local profile="standard" machine="" with_lcb=-1 cleanup_on_success=0 keep_models=() selected=()
  while (($#)); do
    case "$1" in
      --profile) profile="$2"; shift 2 ;;
      --machine) machine="$2"; shift 2 ;;
      --with-livecodebench) with_lcb=1; shift ;;
      --without-livecodebench) with_lcb=0; shift ;;
      --cleanup-on-success) cleanup_on_success=1; shift ;;
      --keep-model) keep_models+=("$2"); shift 2 ;;
      --*) echo "Unknown option: $1" >&2; exit 2 ;;
      *) selected+=("$1"); shift ;;
    esac
  done
  [[ "$profile" =~ ^(quick|standard|full)$ ]] || { echo "ERROR: invalid profile: $profile" >&2; exit 2; }
  if ((${#selected[@]}==0)); then selected=(core); fi
  if [[ " ${selected[*]} " == *" all "* ]]; then selected=("${BENCHES[@]}"); fi
  if ((with_lcb < 0)); then
    if [[ " ${selected[*]} " == *" coding-agent "* ]]; then with_lcb=1; else with_lcb=0; fi
  fi
  local b
  for b in "${selected[@]}"; do
    [[ " ${BENCHES[*]} " == *" $b "* ]] || { echo "ERROR: unknown benchmark: $b" >&2; exit 2; }
  done
  if [[ -z "$machine" ]]; then
    machine="$(hostname -s 2>/dev/null || hostname)"
  fi
  local machine_config; machine_config="$(find_machine_config)"
  configure_cache_dir
  [[ -d "$RESULTS_ROOT" && -w "$RESULTS_ROOT" ]] || {
    echo "ERROR: results directory is missing or not writable: $RESULTS_ROOT" >&2
    echo "Run ./bootstrap.sh first." >&2
    exit 1
  }
  local selected_csv; selected_csv="$(IFS=,; echo "${selected[*]}")"

  local scan_dir="$RESULTS_ROOT/scans/$machine"
  mkdir -p "$scan_dir"
  machine_config="$scan_dir/eligible.models.tsv"
  "$PY" "$ROOT/scripts/scan_machine.py" --models "$ROOT/config/models.toml" --output "$scan_dir/latest.json" --eligible-config "$machine_config"

  if ((with_lcb)) && [[ " $selected_csv " != *"coding-agent"* ]]; then
    echo "ERROR: --with-livecodebench requires coding-agent to be selected." >&2; exit 2
  fi
  echo "Preflight: checking dependencies, Ollama, and models..."
  "$ROOT/scripts/preflight.sh" "$selected_csv" "$machine_config" "$with_lcb" "$profile"

  local run_id run_dir now
  now="$(date -u +%Y%m%dT%H%M%SZ)"
  run_id="${now}-$(printf '%04x' $((RANDOM % 65536)))"
  run_dir="$RESULTS_ROOT/runs/$machine/$run_id"
  mkdir -p "$run_dir/raw" "$run_dir/summary" "$run_dir/config" "$run_dir/source"

  # Freeze the exact benchmark source/fixtures for this run. This keeps a running or resumed
  # benchmark reproducible even when the public Git checkout is updated afterwards. Virtual
  # environments, Git metadata, caches and generated bytecode are intentionally excluded.
  "$PY" - "$ROOT" "$run_dir/source" <<'PY'
import os, shutil, sys
from pathlib import Path
src=Path(sys.argv[1]).resolve(); dst=Path(sys.argv[2]).resolve()
ignore_dirs={'.git','.venv','.venv-lcb','__pycache__'}
ignore_suffixes={'.pyc','.pyo'}
for root, dirs, files in os.walk(src):
    rel=Path(root).relative_to(src)
    dirs[:] = [d for d in dirs if d not in ignore_dirs]
    out=dst/rel
    out.mkdir(parents=True, exist_ok=True)
    for name in files:
        if Path(name).suffix in ignore_suffixes:
            continue
        source=Path(root)/name
        target=out/name
        if source.is_symlink():
            target.symlink_to(os.readlink(source))
        else:
            shutil.copy2(source,target)
PY
  # Runtime environments stay shared to avoid duplicating many GB per run; only source/fixtures are frozen.
  [[ -d "$ROOT/.venv" ]] && ln -s "$ROOT/.venv" "$run_dir/source/.venv"
  [[ -d "$ROOT/.venv-lcb" ]] && ln -s "$ROOT/.venv-lcb" "$run_dir/source/.venv-lcb"

  # One unified model configuration is frozen per run. Every suite filters its own backend/suite rows.
  cp "$machine_config" "$run_dir/config/machine.models.tsv"
  machine_config="$run_dir/config/machine.models.tsv"
  local git_commit="" git_dirty="unknown"
  git_commit="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || true)"
  if [[ -n "$git_commit" ]]; then
    if [[ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null || true)" ]]; then git_dirty="true"; else git_dirty="false"; fi
  fi
  local python_environment
  python_environment="$(python_environment_fingerprint)"
  "$PY" - "$run_dir/raw/source.json" "$machine_config" "$git_commit" "$git_dirty" "$run_dir/source" "$python_environment" <<'PY'
import hashlib,json,sys
from datetime import datetime,timezone
from pathlib import Path
out=Path(sys.argv[1]); cfg=Path(sys.argv[2]); commit=sys.argv[3] or None; dirty=sys.argv[4]; source_root=Path(sys.argv[5]); python_environment=json.loads(sys.argv[6])
h=hashlib.sha256()
for f in sorted(x for x in source_root.rglob('*') if x.is_file() and not x.is_symlink()):
    h.update(str(f.relative_to(source_root)).encode()); h.update(b'\0'); h.update(f.read_bytes()); h.update(b'\0')
version_file=source_root/"VERSION"
version=version_file.read_text(encoding="utf-8").strip() if version_file.exists() else "v4"
data={
  "benchmark_version":version,
  "git_commit":commit,
  "git_dirty": None if dirty=="unknown" else dirty=="true",
  "source_snapshot":"source",
  "source_snapshot_sha256":h.hexdigest(),
  "machine_model_config_sha256":hashlib.sha256(cfg.read_bytes()).hexdigest(),
  "python_environment":python_environment,
  "captured_at":datetime.now(timezone.utc).isoformat(timespec="seconds"),
}
out.write_text(json.dumps(data,indent=2)+"\n",encoding="utf-8")
PY
  local keep_models_json
  keep_models_json="$(printf '%s\n' "${keep_models[@]}" | "$PY" -c 'import json,sys; print(json.dumps([x.strip() for x in sys.stdin if x.strip()]))')"
  "$PY" - "$run_dir" "$run_id" "$machine" "$profile" "$selected_csv" "$with_lcb" "$cleanup_on_success" "$keep_models_json" "$BENCH_CACHE_DIR" <<'PY'
import json,sys
from datetime import datetime,timezone
from pathlib import Path
run=Path(sys.argv[1]); rid=sys.argv[2]; machine=sys.argv[3]; profile=sys.argv[4]; selected=sys.argv[5].split(','); with_lcb=sys.argv[6]=='1'
cleanup_on_success=sys.argv[7]=='1'; keep_models=json.loads(sys.argv[8]); cache_dir=sys.argv[9]
state={
 "schema_version":1,"run_id":rid,"machine":machine,"profile":profile,"selected_benchmarks":selected,"with_livecodebench":with_lcb,
 "status":"starting","created_at":datetime.now(timezone.utc).isoformat(timespec='seconds'),"started_at":None,
 "pid":None,"completed_jobs":{},"progress":{"completed":0,"total":0,"percent":0,"current":None},"benchmarks":{},
 "cleanup":{"on_success":cleanup_on_success,"remove_cache":cleanup_on_success,"remove_ollama_models":cleanup_on_success,"keep_ollama_models":keep_models,"cache_dir":cache_dir}
}
(run/'state.json').write_text(json.dumps(state,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
(run/'run.json').write_text(json.dumps({k:state[k] for k in ['schema_version','run_id','machine','profile','selected_benchmarks','with_livecodebench','cleanup','created_at']},ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
PY
  "$PY" - "$run_dir/state.json" <<'PY'
import json,sys
from datetime import datetime,timezone
p=sys.argv[1]; s=json.load(open(p)); s['started_at']=datetime.now(timezone.utc).isoformat(timespec='seconds'); open(p,'w').write(json.dumps(s,indent=2)+'\n')
PY

  local log="$run_dir/benchmark.log"
  local run_source="$run_dir/source"
  local runner=("$PY" "$run_source/scripts/runner.py" --run-dir "$run_dir" --machine-config "$machine_config")
  if [[ "$(uname -s)" == "Darwin" ]] && command -v caffeinate >/dev/null 2>&1; then
    nohup caffeinate -i -m "${runner[@]}" >>"$log" 2>&1 < /dev/null &
  else
    nohup "${runner[@]}" >>"$log" 2>&1 < /dev/null &
  fi
  local pid=$!
  echo "$pid" > "$run_dir/launcher.pid"
  sleep 0.5
  echo
  echo "Run started: $run_id"
  echo "Machine:     $machine"
  echo "Benchmarks:  $selected_csv"
  echo "Profile:     $profile"
  ((with_lcb)) && echo "LiveCodeBench: enabled (sandboxed)"
  echo "Results:     $run_dir"
  echo
  echo "The SSH session or terminal may now be closed."
  echo "Status: ./benchmark status $run_id"
  echo "Stop:   ./benchmark stop $run_id"
  if ((cleanup_on_success)); then
    echo "Cleanup: enabled; retaining: ${keep_models[*]:-(none)}"
  fi
}

scan_models() {
  local machine="$(hostname -s 2>/dev/null || hostname)"
  (($# == 0)) || { echo "ERROR: benchmark scan does not accept arguments." >&2; exit 2; }
  [[ -d "$RESULTS_ROOT" && -w "$RESULTS_ROOT" ]] || {
    echo "ERROR: results directory is missing or not writable: $RESULTS_ROOT" >&2
    echo "Run ./bootstrap.sh first." >&2
    exit 1
  }
  local scan_dir="$RESULTS_ROOT/scans/$machine"
  mkdir -p "$scan_dir"
  "$PY" "$ROOT/scripts/scan_machine.py" --models "$ROOT/config/models.toml" --output "$scan_dir/latest.json" --eligible-config "$scan_dir/eligible.models.tsv" --report
}

show_status() {
  local run_dir; run_dir="$(resolve_run "${1:-}")"
  [[ -n "$run_dir" ]] || { echo "No runs found."; exit 1; }
  "$PY" - "$run_dir/state.json" <<'PY'
import json,sys
s=json.load(open(sys.argv[1]))
p=s.get('progress') or {}; c=p.get('current') or {}
print(f"Run:        {s.get('run_id')}")
print(f"Machine:    {s.get('machine')}")
print(f"Status:     {s.get('status')}")
print(f"Profile:    {s.get('profile')}")
print(f"Benchmarks: {', '.join(s.get('selected_benchmarks', []))}")
print(f"LiveCodeBench: {'enabled' if s.get('with_livecodebench') else 'disabled'}")
print(f"Progress:   {p.get('completed',0)} / {p.get('total',0)} ({p.get('percent',0)}%)")
if c:
    line=f"Current:    {c.get('benchmark','?')} | {c.get('model','?')} | {c.get('mode','?')} | {c.get('test','?')} | repeat {c.get('repeat','?')}/{c.get('repeats','?')}"
    if c.get('turn'): line += f" | turn {c['turn']}/{c.get('turns','?')}"
    print(line)
if s.get('error'):
    print(f"Error:      {s['error'].get('type')}: {s['error'].get('message')}")
PY
  echo "Log:        $run_dir/benchmark.log"
}

stop_run() {
  local id="" force=0
  while (($#)); do
    case "$1" in --force) force=1; shift;; *) id="$1"; shift;; esac
  done
  local run_dir; run_dir="$(resolve_run "$id")"
  [[ -n "$run_dir" ]] || { echo "No runs found."; exit 1; }
  if ((force)); then
    local pid=""
    [[ -f "$run_dir/runner.pid" ]] && pid="$(cat "$run_dir/runner.pid")"
    [[ -z "$pid" && -f "$run_dir/launcher.pid" ]] && pid="$(cat "$run_dir/launcher.pid")"
    if [[ -n "$pid" ]]; then kill -TERM "$pid" 2>/dev/null || true; sleep 1; kill -KILL "$pid" 2>/dev/null || true; fi
    echo "Force stop sent for $(basename "$run_dir")."
  else
    touch "$run_dir/stop.requested"
    echo "Graceful stop requested for $(basename "$run_dir"). The current Ollama call may finish."
  fi
}

resume_run() {
  local run_dir; run_dir="$(resolve_run "${1:-}")"
  [[ -n "$run_dir" ]] || { echo "No runs found."; exit 1; }
  configure_cache_dir
  local machine; machine="$($PY -c 'import json,sys; print(json.load(open(sys.argv[1]))["machine"])' "$run_dir/state.json")"
  local machine_config="$run_dir/config/machine.models.tsv"
  local source_file="$run_dir/raw/source.json"
  local run_source="$run_dir/source"
  if [[ ! -f "$run_source/scripts/runner.py" ]]; then
    # Backwards compatibility for old runs created before per-run source snapshots existed.
    run_source="$ROOT"
    if [[ -f "$source_file" ]]; then
      local original_commit current_commit
      original_commit="$($PY -c 'import json,sys; print(json.load(open(sys.argv[1])).get("git_commit") or "")' "$source_file")"
      current_commit="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || true)"
      if [[ -n "$original_commit" && -n "$current_commit" && "$original_commit" != "$current_commit" ]]; then
        echo "ERROR: the old run without a source snapshot started at Git commit $original_commit, but the repository is now at $current_commit." >&2
        echo "Check out the original commit or start a new run." >&2
        exit 1
      fi
    fi
  fi
  if [[ ! -f "$machine_config" ]]; then
    # Backwards compatibility for runs created before per-run config snapshots existed.
    machine_config="$(find_machine_config)"
  fi
  local selected_csv profile with_lcb
  selected_csv="$($PY -c 'import json,sys; print(",".join(json.load(open(sys.argv[1]))["selected_benchmarks"]))' "$run_dir/state.json")"
  profile="$($PY -c 'import json,sys; print(json.load(open(sys.argv[1]))["profile"])' "$run_dir/state.json")"
  with_lcb="$($PY -c 'import json,sys; print(1 if json.load(open(sys.argv[1])).get("with_livecodebench") else 0)' "$run_dir/state.json")"
  echo "Resume preflight: checking dependencies, Ollama, and the original models..."
  # Use the snapshotted dependency hooks where possible. They may refer to the repository venv,
  # so expose the live venv to the snapshot without copying gigabytes into every run.
  if [[ "$run_source" != "$ROOT" && -d "$ROOT/.venv" ]]; then
    [[ -L "$run_source/.venv" && ! -e "$run_source/.venv" ]] && rm -f "$run_source/.venv"
    [[ -e "$run_source/.venv" || -L "$run_source/.venv" ]] || ln -s "$ROOT/.venv" "$run_source/.venv"
  fi
  if [[ "$run_source" != "$ROOT" && -d "$ROOT/.venv-lcb" ]]; then
    [[ -L "$run_source/.venv-lcb" && ! -e "$run_source/.venv-lcb" ]] && rm -f "$run_source/.venv-lcb"
    [[ -e "$run_source/.venv-lcb" || -L "$run_source/.venv-lcb" ]] || ln -s "$ROOT/.venv-lcb" "$run_source/.venv-lcb"
  fi
  "$run_source/scripts/preflight.sh" "$selected_csv" "$machine_config" "$with_lcb" "$profile"
  if [[ -f "$source_file" ]]; then
    local python_environment
    python_environment="$(python_environment_fingerprint)"
    "$PY" - "$source_file" "$python_environment" <<'PY'
import json, sys

source = json.load(open(sys.argv[1]))
expected = source.get("python_environment")
current = json.loads(sys.argv[2])
if expected is not None and current != expected:
    raise SystemExit("ERROR: Python dependencies changed since this run started. Start a new run instead of resuming.")
PY
  fi
  rm -f "$run_dir/stop.requested"
  "$PY" - "$run_dir/state.json" <<'PY'
import json,sys
p=sys.argv[1]; s=json.load(open(p));
if s.get('status')=='completed': raise SystemExit('ERROR: this run is already completed.')
s['status']='resuming'; s.pop('error',None); open(p,'w').write(json.dumps(s,indent=2)+'\n')
PY
  local log="$run_dir/benchmark.log"
  local runner=("$PY" "$run_source/scripts/runner.py" --run-dir "$run_dir" --machine-config "$machine_config" --resume)
  if [[ "$(uname -s)" == "Darwin" ]] && command -v caffeinate >/dev/null 2>&1; then
    nohup caffeinate -i -m "${runner[@]}" >>"$log" 2>&1 < /dev/null &
  else
    nohup "${runner[@]}" >>"$log" 2>&1 < /dev/null &
  fi
  echo $! > "$run_dir/launcher.pid"
  echo "Run resumed: $(basename "$run_dir")"
}

list_runs() {
  "$PY" - "$RESULTS_ROOT/runs" <<'PY'
import json,sys
from pathlib import Path
root=Path(sys.argv[1])
rows=[]
for d in root.glob('*/*') if root.exists() else []:
    p=d/'state.json'
    if d.is_dir() and p.exists():
        try:
            s=json.load(open(p))
            rows.append((s.get('created_at',''), f"{s.get('run_id')}\t{s.get('machine')}\t{s.get('status')}\t{s.get('profile')}\t{','.join(s.get('selected_benchmarks',[]))}"))
        except Exception:
            pass
for _,line in sorted(rows): print(line)
PY
}

cleanup_run() {
  local run_dir; run_dir="$(resolve_run "${1:-}")"
  [[ -n "$run_dir" ]] || { echo "No runs found."; exit 1; }
  local cleanup_script="$run_dir/source/scripts/cleanup.py"
  [[ -f "$cleanup_script" ]] || cleanup_script="$ROOT/scripts/cleanup.py"
  "$PY" "$cleanup_script" --run-dir "$run_dir"
}

cmd="${1:-}"
case "$cmd" in
  "") interactive ;;
  start) shift; start_run "$@" ;;
  scan) shift; scan_models "$@" ;;
  status) shift; show_status "${1:-}" ;;
  stop) shift; stop_run "$@" ;;
  resume) shift; resume_run "${1:-}" ;;
  list-runs) list_runs ;;
  cleanup) shift; cleanup_run "${1:-}" ;;
  environment) show_environment ;;
  -h|--help|help) usage ;;
  *) echo "Unknown command: $cmd" >&2; usage; exit 2 ;;
esac
